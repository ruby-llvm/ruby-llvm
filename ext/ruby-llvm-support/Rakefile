# frozen_string_literal: true

require 'rubygems'
require 'rake/clean'
require 'ffi'

require File.expand_path('../../lib/llvm/version', File.dirname(__FILE__))
include LLVM

def check_for(what, variants, env_var)
  variants = [ENV[env_var], *variants] if ENV.include?(env_var)

  $stdout.print("checking for #{what}... ")
  $stdout.flush

  result = variants.find do |variant|
    if yield(variant)
      $stdout.puts(variant)
      true
    end
  end

  raise "Cannot find #{what}: tried #{variants}" unless result
  result
end

def find_llvm_config
  check_for('llvm-config',
            %W[llvm-config-#{LLVM_VERSION} llvm-config],
            'LLVM_CONFIG') do |llvm_config|
    begin
      actual_version = `#{llvm_config} --version`.strip
      actual_maj, actual_min, _ = actual_version.split('.')

      required_maj, required_min = LLVM_REQUIRED_VERSION.split('.')

      actual_maj == required_maj && actual_min == required_min
    rescue Errno::ENOENT
      false
    end
  end
end

def find_cxx
  candidates = if LLVM_MSVC
    # clang-cl is clang's MSVC-compatible driver; it accepts MSVC-style flags
    # (/EHs-c-, /GR-, -std:c++17) that llvm-config --cxxflags emits on Windows.
    ['clang-cl']
  else
    %W[clang++-#{LLVM_VERSION} clang++ g++]
  end
  check_for('C++ compiler', candidates, 'CXX') do |cxx|
    system(cxx, '--version', out: File::NULL, err: File::NULL)
    $?.success?
  end
end

LLVM_CONFIG = find_llvm_config

def invoke_llvm_config(options)
  `#{LLVM_CONFIG} #{options}`.tr("\n", ' ').strip
end

# True when using an MSVC-built LLVM (llvm-config --cxxflags emits MSVC-style flags like
# /EHs-c-, /GR-, -std:c++17) rather than a MinGW/GCC-built LLVM. Detected via host target
# triple so mswin Ruby + MSYS2 LLVM (windows-gnu) still uses clang++ like Linux/macOS.
LLVM_MSVC = invoke_llvm_config('--host-target').include?('windows-msvc')
CXX       = find_cxx

# llvm_lib_name
# Are there any builds where invoke_llvm_config('--libs') will not be sufficient and manual search would still be
# needed?
private def _llvm_lib_name
  lib_dir = invoke_llvm_config('--libdir').strip
  lib_name = 'LLVM'
  versioned_lib_name = "#{lib_name}-#{LLVM_VERSION}"
  versioned_lib_pattern = "lib#{versioned_lib_name}.*"
  versioned_lib_found = Dir.glob(File.join(lib_dir, versioned_lib_pattern)) != []
  versioned_lib_found ? versioned_lib_name : lib_name
end

SUPPORT_LIB = FFI.map_library_name("RubyLLVMSupport-#{LLVM_VERSION}")
CONFIG_MOD  = File.expand_path('../../lib/llvm/config.rb', File.dirname(__FILE__))

CLEAN.include(SUPPORT_LIB, CONFIG_MOD)
# MSVC leaves an import .lib and exports .exp beside the .dll
CLEAN.include("RubyLLVMSupport-#{LLVM_VERSION}.lib", "RubyLLVMSupport-#{LLVM_VERSION}.exp")

desc 'Build the shared library and config module'
task default: [SUPPORT_LIB, CONFIG_MOD]

file SUPPORT_LIB => %w[support.cpp] do |task|
  if LLVM_MSVC
    lib_dir = invoke_llvm_config('--libdir')
    # LLVM-C.lib listed first: LLVMInitializeX86Target etc. (real C API exports) are satisfied
    # by LLVM-C.dll, so target registrations land in LLVM-C.dll's registry — the same one
    # the JIT queries. LLVMCore.lib and its deps provide the two C++ methods not in the C API
    # (Attribute::getAsString, Attribute::getNameFromAttrKind); their TargetRegistry instance
    # inside RubyLLVMSupport-22.dll is unused and harmless.

    # TODO: support dynamic-CRT LLVM builds. clang-cl here defaults to /MT (static CRT), which
    # matches official llvm.org x64 and vovkos libcmt builds (RuntimeLibrary=MT_StaticRelease,
    # /DEFAULTLIB:libcmt). An LLVM built with the dynamic CRT (RuntimeLibrary=MD_DynamicRelease,
    # /DEFAULTLIB:MSVCRT) fails to link with LNK2038. To support both, detect the libs' CRT
    # (e.g. `llvm-readobj --coff-directives #{lib_dir}/LLVMSupport.lib` -> grep RuntimeLibrary,
    # or dumpbin /directives) and add /MD when it reports MD_DynamicRelease.
    sh "#{CXX} /O2 /LD #{task.prerequisites.join(' ')} " \
       "#{invoke_llvm_config('--cxxflags')} " \
       "#{lib_dir}/LLVM-C.lib #{lib_dir}/LLVMCore.lib #{lib_dir}/LLVMBinaryFormat.lib " \
       "#{lib_dir}/LLVMTargetParser.lib #{lib_dir}/LLVMRemarks.lib " \
       "#{lib_dir}/LLVMBitstreamReader.lib #{lib_dir}/LLVMSupport.lib " \
       "#{lib_dir}/LLVMDemangle.lib ntdll.lib /Fe:#{SUPPORT_LIB}"
  else
    sh "#{CXX} -O3 -shared #{task.prerequisites.join(' ')} " \
       "#{invoke_llvm_config('--libs --cxxflags --ldflags')} -fPIC -o #{SUPPORT_LIB}"
  end
end

LLVM_CONFIG_OPTS = [
  ['VERSION',      :string, '--version'],
  ['COMPONENTS',    :array,  '--components'],
  ['TARGETS_BUILT', :array,  '--targets-built'],
  ['HOST_TARGET',   :string, '--host-target'],
  ['BUILD_MODE',    :string, '--build-mode'],
  ['CFLAGS',        :string, '--cflags'],
  ['CXXFLAGS',      :string, '--cxxflags'],
  ['LDFLAGS',       :string, '--ldflags'],
  ['LIBS',          :string, '--libs'],
].freeze

file CONFIG_MOD do
  open(CONFIG_MOD, 'w') do |f|
    f.puts '# Generated by ruby-llvm. Please do not change this file by hand.'
    f.puts 'module LLVM'
    f.puts '  module CONFIG'

    LLVM_CONFIG_OPTS.each do |(const, fmt, flag)|
      case fmt
      when :string
        value = invoke_llvm_config(flag)
      when :array
        value = invoke_llvm_config(flag).split
      end

      f.puts "    #{const} = #{value.inspect}"
    end

    f.puts '  end'
    f.puts 'end'
  end
end
